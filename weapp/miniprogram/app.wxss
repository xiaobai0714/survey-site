page {
  background: linear-gradient(160deg, #eef2ff 0%, #f6f0ff 55%, #eafaf3 100%);
  min-height: 100vh;
}
.container {
  padding: 40rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.card {
  width: 100%;
  max-width: 680rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(80, 100, 180, 0.12);
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}
.hero {
  text-align: center;
  margin-bottom: 36rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2b2f44;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8b90a8;
}
.field {
  margin-bottom: 28rpx;
}
.opinion {
  width: 100%;
  min-height: 220rpx;
  background: #f5f7fb;
  border: 2rpx solid #e6e9f2;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #2b2f44;
  box-sizing: border-box;
  line-height: 1.6;
}
.submit-btn {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #6c8cff, #9b7bff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  height: 92rpx;
  line-height: 92rpx;
}
.submit-btn::after {
  border: none;
}
.msg {
  text-align: center;
  margin-top: 24rpx;
  font-size: 28rpx;
}
.msg.ok {
  color: #2bb673;
}
.msg.err {
  color: #e3556a;
}
.footer {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: #aab0c6;
  text-align: center;
}
.admin-entry {
  align-self: flex-end;
  margin-bottom: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #8b90a8;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  border: 1rpx solid rgba(140, 140, 160, 0.15);
}
